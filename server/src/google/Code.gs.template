/**
 * CertiFlow — Google connector (version 3)
 *
 * What this script does:
 *   1. setup()  creates the "Event Feedback & Certificate" Google Form and a
 *               "CertiFlow Certificate Register" Google Sheet for you.
 *   2. doGet()  lets CertiFlow read new form responses, and shows the public
 *               certificate verification page (…/exec?verify=CF-2026-XXXXXX).
 *   3. doPost() lets CertiFlow email certificates from your Gmail account and
 *               add issued certificates to the register.
 *
 * How to use it (3 minutes):
 *   1. Click Run ▶ with "setup" selected and allow the permissions.
 *   2. Deploy → New deployment → type "Web app"
 *        Execute as: Me      Who has access: Anyone
 *      (Updating? Deploy → Manage deployments → ✏ Edit → Version: New version → Deploy.
 *       The URL stays the same.)
 *   3. Copy the Web app URL and paste it into CertiFlow → Settings.
 *
 * The SECRET below was generated by your CertiFlow app. Only requests that
 * carry it can read responses or send email, so keep this script private.
 */

const SCRIPT_VERSION = 3;
const SECRET = '{{SECRET}}';
// Address of CertiFlow when it runs online (empty when it runs on a laptop). Used by keepAwake().
const APP_URL = '{{APP_URL}}';
const FORM_TITLE = 'Event Feedback & Certificate';
const REGISTER_TITLE = 'CertiFlow Certificate Register';
const REGISTER_HEADERS = ['Certificate ID', 'Name', 'Register No (masked)', 'College', 'Event', 'Event date', 'Organised by', 'Issued on', 'Status'];

// Question titles. CertiFlow reads answers by these keys.
const QUESTIONS = {
  name: 'Full Name',
  regNo: 'Register Number',
  college: 'College Name',
  eventName: 'Event Name',
  code: 'Event Code',
  email: 'Email ID',
  rating: 'Overall rating of the event',
  review: 'How was the event?',
  comments: 'Comments or suggestions',
};
const REVIEW_OPTIONS = ['Excellent', 'Very Good', 'Good', 'Average', 'Poor'];

function setup() {
  const form = getOrCreateForm_();
  const register = getOrCreateRegister_();
  // Touching MailApp here makes Google ask for the "send email" permission now.
  const quota = MailApp.getRemainingDailyQuota();
  Logger.log('Form ready: ' + form.getPublishedUrl());
  Logger.log('Certificate register: ' + register.getUrl());
  Logger.log('Emails you can still send today: ' + quota);
  Logger.log('Next: Deploy > New deployment > Web app (Execute as: Me, Who has access: Anyone), then paste the Web app URL into CertiFlow Settings.');
}

// Optional, only for CertiFlow hosted online on a free plan that sleeps when idle (e.g. Render):
// run setupKeepAwake once and Google wakes CertiFlow every 10 minutes, so certificates keep going out.
function setupKeepAwake() {
  if (!APP_URL) throw new Error('APP_URL is empty. Copy the script again from CertiFlow Settings after deploying it online.');
  ScriptApp.getProjectTriggers()
    .filter(function (t) { return t.getHandlerFunction() === 'keepAwake'; })
    .forEach(function (t) { ScriptApp.deleteTrigger(t); });
  ScriptApp.newTrigger('keepAwake').timeBased().everyMinutes(10).create();
  keepAwake();
  Logger.log('Done. Google will open ' + APP_URL + ' every 10 minutes.');
}

function keepAwake() {
  if (APP_URL) UrlFetchApp.fetch(APP_URL.replace(/\/+$/, '') + '/api/health', { muteHttpExceptions: true });
}

function getOrCreateForm_() {
  const props = PropertiesService.getScriptProperties();
  const id = props.getProperty('FORM_ID');
  if (id) {
    try {
      return FormApp.openById(id);
    } catch (err) {
      // Form was deleted; make a new one below.
    }
  }

  const form = FormApp.create(FORM_TITLE);
  form.setDescription('Thanks for attending! Fill this in to get your e-certificate by email.');
  form.setConfirmationMessage('Thank you! Your certificate will reach your email in a few minutes.');
  form.setAllowResponseEdits(false);

  form.addTextItem().setTitle(QUESTIONS.name).setHelpText('As it should appear on the certificate').setRequired(true);
  form.addTextItem().setTitle(QUESTIONS.regNo).setRequired(true);
  form.addTextItem().setTitle(QUESTIONS.college).setRequired(true);
  form.addTextItem().setTitle(QUESTIONS.eventName).setHelpText('Filled in automatically when you scan the event QR code').setRequired(true);
  addCodeQuestion_(form);

  const email = form.addTextItem().setTitle(QUESTIONS.email).setRequired(true);
  email.setValidation(FormApp.createTextValidation().setHelpText('Enter a valid email address').requireTextIsEmail().build());

  form.addScaleItem().setTitle(QUESTIONS.rating).setBounds(1, 5).setLabels('Poor', 'Excellent').setRequired(true);
  form.addMultipleChoiceItem().setTitle(QUESTIONS.review).setChoiceValues(REVIEW_OPTIONS).setRequired(true);
  form.addParagraphTextItem().setTitle(QUESTIONS.comments).setRequired(false);

  props.setProperty('FORM_ID', form.getId());
  return form;
}

// Version 3 adds an optional "Event Code" question, used when an event shows a code on the projector.
// Forms made by older versions get it added automatically, right after "Event Name".
function addCodeQuestion_(form) {
  const item = form.addTextItem().setTitle(QUESTIONS.code)
    .setHelpText('Only if a code is shown on the screen at the event. Otherwise leave it blank.')
    .setRequired(false);
  const eventItem = form.getItems().filter(function (i) { return i.getTitle() === QUESTIONS.eventName; })[0];
  if (eventItem) form.moveItem(item.getIndex(), eventItem.getIndex() + 1);
  return item;
}

function ensureCodeQuestion_(form) {
  const has = form.getItems().some(function (i) { return i.getTitle() === QUESTIONS.code; });
  if (!has) addCodeQuestion_(form);
}

function getOrCreateRegister_() {
  const props = PropertiesService.getScriptProperties();
  const id = props.getProperty('REGISTER_ID');
  if (id) {
    try {
      return SpreadsheetApp.openById(id);
    } catch (err) {
      // Sheet was deleted; make a new one below.
    }
  }
  const ss = SpreadsheetApp.create(REGISTER_TITLE);
  const sheet = ss.getSheets()[0];
  sheet.setName('Certificates');
  sheet.getRange(1, 1, 1, REGISTER_HEADERS.length).setValues([REGISTER_HEADERS]).setFontWeight('bold');
  sheet.setFrozenRows(1);
  props.setProperty('REGISTER_ID', ss.getId());
  return ss;
}

function registerSheet_() {
  return getOrCreateRegister_().getSheets()[0];
}

function json_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

// Builds a pre-filled link and returns the entry id of the "Event Name" question,
// so CertiFlow can create a QR code per event with the event name already filled.
function formInfo_(form) {
  const item = form.getItems().filter(function (i) { return i.getTitle() === QUESTIONS.eventName; })[0];
  let eventEntryId = null;
  if (item) {
    const url = form.createResponse().withItemResponse(item.asTextItem().createResponse('__EVENT__')).toPrefilledUrl();
    const m = url.match(/entry\.(\d+)=__EVENT__/);
    eventEntryId = m ? m[1] : null;
  }
  return {
    ok: true,
    version: SCRIPT_VERSION,
    verify: true,
    codeQuestion: form.getItems().some(function (i) { return i.getTitle() === QUESTIONS.code; }),
    registerUrl: getOrCreateRegister_().getUrl(),
    formTitle: form.getTitle(),
    formUrl: form.getPublishedUrl(),
    editUrl: form.getEditUrl(),
    eventEntryId: eventEntryId,
    acceptingResponses: form.isAcceptingResponses(),
    emailQuota: MailApp.getRemainingDailyQuota(),
  };
}

function readResponses_(form, sinceIso, limit) {
  const since = sinceIso ? new Date(sinceIso) : new Date(0);
  const titleToKey = {};
  Object.keys(QUESTIONS).forEach(function (k) { titleToKey[QUESTIONS[k]] = k; });

  const all = form.getResponses(since);
  const responses = all.slice(0, limit).map(function (r) {
    const answers = {};
    r.getItemResponses().forEach(function (ir) {
      const key = titleToKey[ir.getItem().getTitle()];
      if (key) answers[key] = ir.getResponse();
    });
    return { id: r.getId(), submittedAt: r.getTimestamp().toISOString(), answers: answers };
  });
  return { ok: true, count: responses.length, hasMore: all.length > limit, responses: responses };
}

// Adds new certificates to the register, or updates ones already there (e.g. revoked)
function publish_(records) {
  const sheet = registerSheet_();
  const last = sheet.getLastRow();
  const ids = last > 1 ? sheet.getRange(2, 1, last - 1, 1).getValues().map(function (r) { return String(r[0]); }) : [];
  const rowOf = {};
  ids.forEach(function (id, i) { rowOf[id] = i + 2; });

  const toAppend = [];
  (records || []).forEach(function (r) {
    const row = [r.certificateId, r.name, r.regNo, r.college, r.event, r.eventDate, r.organizer, r.issuedAt, r.status];
    if (rowOf[r.certificateId]) sheet.getRange(rowOf[r.certificateId], 1, 1, row.length).setValues([row]);
    else toAppend.push(row);
  });
  if (toAppend.length) sheet.getRange(sheet.getLastRow() + 1, 1, toAppend.length, toAppend[0].length).setValues(toAppend);
  return { ok: true, published: (records || []).length };
}

function escape_(s) {
  return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
  });
}

// Public page anyone can open by scanning the QR code on a certificate
function verifyPage_(rawId) {
  const id = String(rawId || '').trim().toUpperCase();
  let row = null;
  if (/^CF-\d{4}-[A-Z0-9]{6}$/.test(id)) {
    const found = registerSheet_().getRange('A:A').createTextFinder(id).matchEntireCell(true).findNext();
    if (found) row = registerSheet_().getRange(found.getRow(), 1, 1, REGISTER_HEADERS.length).getDisplayValues()[0];
  }

  let body;
  if (!row) {
    body = '<div class="box bad"><h1>Not a valid certificate</h1><p>No certificate exists with the ID <b>' + escape_(id || '(none)') +
      '</b>. Check the ID for typos.</p></div>';
  } else {
    const valid = row[8] === 'active';
    const details = [['Awarded to', row[1]], ['Register no.', row[2]], ['College', row[3]], ['Event', row[4]],
      ['Event date', row[5]], ['Organised by', row[6]], ['Issued on', row[7]], ['Certificate ID', row[0]]]
      .map(function (d) { return '<tr><th>' + d[0] + '</th><td>' + escape_(d[1]) + '</td></tr>'; }).join('');
    body = '<div class="box ' + (valid ? 'ok' : 'bad') + '"><h1>' +
      (valid ? '✔ This certificate is genuine' : '✖ This certificate has been revoked') + '</h1><p>' +
      (valid ? 'Issued by ' + escape_(row[6]) : escape_(row[6]) + ' has withdrawn it. It is no longer valid.') +
      '</p></div><table>' + details + '</table>';
  }

  const html = '<!doctype html><html><head><meta charset="utf-8"><style>' +
    'body{font-family:Arial,Helvetica,sans-serif;background:#f2f4f8;color:#1b2340;margin:0;padding:24px}' +
    '.wrap{max-width:560px;margin:0 auto}.brand{font:600 22px Georgia,serif;margin-bottom:20px}' +
    '.box{border-radius:12px;padding:18px 20px;margin-bottom:16px}.ok{background:#e5f4ec;color:#1e7a55}.bad{background:#fdecea;color:#b42318}' +
    'h1{font-size:20px;margin:0 0 4px}p{margin:0;color:#3a4260}table{width:100%;background:#fff;border-radius:12px;border-collapse:collapse}' +
    'th,td{text-align:left;padding:10px 16px;border-bottom:1px solid #dde2ec;font-size:15px}th{color:#5b6275;font-weight:normal;width:38%}' +
    '</style></head><body><div class="wrap"><div class="brand">CertiFlow certificate check</div>' + body + '</div></body></html>';
  return HtmlService.createHtmlOutput(html).setTitle('Certificate verification').addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

function doGet(e) {
  const p = (e && e.parameter) || {};
  if (p.verify !== undefined) return verifyPage_(p.verify);
  if (p.key !== SECRET) return json_({ ok: false, error: 'unauthorized' });
  try {
    const form = getOrCreateForm_();
    ensureCodeQuestion_(form);
    if (p.action === 'responses') return json_(readResponses_(form, p.since, Math.min(Number(p.limit) || 200, 500)));
    return json_(formInfo_(form));
  } catch (err) {
    return json_({ ok: false, error: String(err) });
  }
}

function doPost(e) {
  let body = {};
  try {
    body = JSON.parse(e.postData.contents);
  } catch (err) {
    return json_({ ok: false, error: 'invalid JSON' });
  }
  if (body.key !== SECRET) return json_({ ok: false, error: 'unauthorized' });

  try {
    if (body.action === 'sendEmail') {
      const attachments = (body.attachments || []).map(function (a) {
        return Utilities.newBlob(Utilities.base64Decode(a.base64), a.contentType || 'application/pdf', a.filename);
      });
      MailApp.sendEmail({
        to: body.to,
        subject: body.subject,
        htmlBody: body.html,
        body: body.text || '',
        name: body.senderName || 'CertiFlow',
        attachments: attachments,
      });
      return json_({ ok: true, emailQuota: MailApp.getRemainingDailyQuota() });
    }
    if (body.action === 'publish') return json_(publish_(body.records));
    return json_({ ok: false, error: 'unknown action' });
  } catch (err) {
    return json_({ ok: false, error: String(err) });
  }
}
