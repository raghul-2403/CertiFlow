# CertiFlow works with NO .env file at all.
# Copy this to .env only if you want to change something.

# --- Server ---
PORT=5000
# Only set this if CertiFlow is deployed online, e.g. https://certiflow-yourclub.onrender.com
# Left empty, certificate QR codes use the public verify page of your Google script (works on any phone).
PUBLIC_BASE_URL=

# --- Database ---
# Leave empty to use the built-in database stored in server/.data (recommended for demos).
# For deployment, paste a MongoDB Atlas connection string:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/certiflow
MONGODB_URI=
# Port for the built-in local database (change only if another program uses it)
LOCAL_DB_PORT=27031

# --- First admin login (only used when the database is empty) ---
ADMIN_EMAIL=admin@certiflow.local
ADMIN_PASSWORD=Admin@123

# --- How often to check the Google Form for new responses (seconds, min 10) ---
SYNC_INTERVAL_SEC=30

# --- Optional SMTP ---
# Leave SMTP_USER empty to send certificates from the Gmail account connected in Settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Optional ---
# JWT_SECRET=   (generated automatically and stored in the database if empty)
# JWT_EXPIRES_IN=1d
